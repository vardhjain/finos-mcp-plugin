{
  "$schema": "https://agent-plugins.org/schemas/1.0.0/mcp.schema.json",
  "mcpServers": {
    "finos-aigf": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${PLUGIN_ROOT}",
        "python",
        "${PLUGIN_ROOT}/servers/aigf.py"
      ]
    },
    "finos-cdm": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${PLUGIN_ROOT}",
        "python",
        "${PLUGIN_ROOT}/servers/cdm.py"
      ]
    },
    "finos-fdc3": {
      "type": "stdio",
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${PLUGIN_ROOT}",
        "python",
        "${PLUGIN_ROOT}/servers/fdc3.py"
      ]
    }
  }
}
